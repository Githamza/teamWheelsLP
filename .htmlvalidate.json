{
  "$schema": "https://html-validate.org/schemas/config.json",
  "extends": ["html-validate:recommended"],
  "rules": {
    "attr-quotes": "off",
    "doctype-style": "off",
    "void-style": "off",
    "attribute-boolean-style": "off",
    "no-trailing-whitespace": "off",
    "no-inline-style": "off",
    "require-sri": "off",
    "long-title": "off",
    "no-raw-characters": ["error", { "relaxed": true }],
    "hidden-focusable": "off",
    "prefer-native-element": "off",
    "valid-id": "off",
    "wcag/h30": "off",
    "wcag/h32": "off",
    "wcag/h37": "off",
    "wcag/h63": "off",
    "wcag/h67": "off",
    "wcag/h71": "off"
  }
}
