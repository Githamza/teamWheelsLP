##### Optimize default expiration time - BEGIN
<IfModule mod_expires.c>

  ## Enable expiration control
  ExpiresActive On

  ## Default expiration: 1 month (fallback for any unmatched types)
  ExpiresDefault "access plus 1 month"

  ## HTML pages: short cache to allow quick updates
  ExpiresByType text/html "access plus 10 minutes"

  ## CSS and JS expiration: 1 year (Hugo uses cache-busted filenames)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  ## Image files expiration: 1 year (Hugo fingerprints image filenames)
  ExpiresByType image/bmp "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jp2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/ico "access plus 1 year"
  ExpiresByType image/icon "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"

  ## Font files expiration: 1 year
  ExpiresByType application/x-font-ttf "access plus 1 year"
  ExpiresByType application/x-font-opentype "access plus 1 year"
  ExpiresByType application/x-font-woff "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  ## Audio files expiration: 1 year
  ExpiresByType audio/ogg "access plus 1 year"
  ExpiresByType application/ogg "access plus 1 year"
  ExpiresByType audio/mpeg "access plus 1 year"
  ExpiresByType audio/mp3 "access plus 1 year"
  ExpiresByType audio/x-wav "access plus 1 year"

  ## Video files expiration: 1 year
  ExpiresByType video/x-msvideo "access plus 1 year"
  ExpiresByType video/mpeg "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/quicktime "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
</IfModule>
##### Optimize default expiration time - END

##### Cache-Control headers
<IfModule mod_headers.c>
  ## HTML: short cache, must revalidate
  <FilesMatch "\.(html)$">
    Header set Cache-Control "max-age=600, public, must-revalidate"
  </FilesMatch>

  ## Static assets: 1 year cache with immutable (Hugo fingerprints filenames)
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|avif|gif|ico|svg|woff|woff2|eot|ttf|otf|mp4|webm|ogg|mp3)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>

##### Agent-discovery Link headers (RFC 8288 / RFC 9727)
## Advertise machine-readable resources so AI agents and automated
## clients can find the API catalog, agent-skills index, sitemap,
## service docs and health endpoint from any response on this origin.
##
## Emitted unconditionally: SetEnvIf/env= gating is silently skipped
## on this shared host, and FilesMatch "\.html$" does not match
## directory URLs like "/" or "/fr/". Emitting on every response is
## ~500 bytes of HPACK-compressible header per hit — fine.
<IfModule mod_headers.c>
  Header always append Link "</.well-known/api-catalog>; rel=\"api-catalog\"; type=\"application/linkset+json\""
  Header always append Link "</.well-known/agent-skills/index.json>; rel=\"https://agentskills.io/rel/index\"; type=\"application/json\""
  Header always append Link "</sitemap.xml>; rel=\"sitemap http://www.sitemaps.org/schemas/sitemap/0.9\"; type=\"application/xml\""
  Header always append Link "</fr/how-it-works/>; rel=\"service-doc\"; type=\"text/html\"; hreflang=\"fr\""
  Header always append Link "</en/how-it-works/>; rel=\"service-doc\"; type=\"text/html\"; hreflang=\"en\""
  Header always append Link "</status.json>; rel=\"status\"; type=\"application/json\""

  ## Serve the api-catalog with the correct RFC 9264 link-set media type
  <Files "api-catalog">
    Header set Content-Type "application/linkset+json"
    Header set Cache-Control "max-age=3600, public"
  </Files>

  ## Web Bot Auth — serve the JWKS directory with the IETF media type
  ## so verifiers can identify signed requests originating from this site.
  <Files "http-message-signatures-directory">
    Header set Content-Type "application/http-message-signatures-directory+json"
    Header set Cache-Control "max-age=3600, public"
  </Files>

  ## Health endpoint advertised by the api-catalog (rel="status").
  <Files "status.json">
    Header set Content-Type "application/json"
    Header set Cache-Control "max-age=60, public"
  </Files>

  ## Agent Skills discovery index (Cloudflare / agentskills.io RFC v0.2.0).
  <FilesMatch "^index\.json$">
    Header set Cache-Control "max-age=3600, public"
  </FilesMatch>
</IfModule>

##### Markdown content negotiation for agents (Accept: text/markdown)
## The shared host silently drops mod_rewrite rules from .htaccess, so
## drive the negotiation through Apache's native mod_negotiation
## (MultiViews) instead. Hugo's `md` output format emits an `index.md`
## next to every `index.html`, and a static `/index.md` covers the
## multilang root.
##
## How it works:
##   1. `DirectoryIndex index index.html` tells Apache to look for an
##      `index` (no extension) first when a directory URL is hit.
##   2. `index` does not exist as a file, so `Options +MultiViews`
##      kicks in: Apache enumerates `index.*` siblings, ranks them by
##      the request's Accept header, and serves the winner.
##   3. Browsers (Accept: text/html,...) get `index.html`; agents
##      sending `Accept: text/markdown` get `index.md`. Apache sets
##      Content-Type from the chosen file and adds `Vary: negotiate,
##      Accept` automatically so caches key on the Accept header.
##   4. `index.html` stays as the trailing DirectoryIndex fallback so
##      directories without a markdown sibling (e.g. /admin/) still
##      resolve — MultiViews serves HTML there since it's the only
##      representation available.
##
## Keep a mod_rewrite rule as a belt-and-braces fallback in case
## MultiViews is disabled on some hosts.
##
## See https://developers.cloudflare.com/fundamentals/reference/markdown-for-agents/
<IfModule mod_negotiation.c>
  Options +MultiViews
  DirectoryIndex index index.html
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  ## Shared hosts sometimes block /.well-known/ — pass it through.
  RewriteRule "^\.well-known/" - [L]

  ## Directory URL + Accept: text/markdown + an index.md sibling → serve
  ## the markdown in place. Harmless when MultiViews already handled it.
  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteCond %{REQUEST_URI} /$
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}index.md -f
  RewriteRule ^(.*)$ $1index.md [L,QSA,T=text/markdown]
</IfModule>

## PageSpeed only knows how to rewrite HTML/CSS/JS — leave markdown alone,
## and make it honour Vary: Accept so the cached HTML copy isn't served
## to an agent that asked for markdown.
<IfModule pagespeed_module>
  ModPagespeedDisallow "*.md"
  ModPagespeedRespectVary on
</IfModule>

<IfModule mod_headers.c>
  ## Signal that HTML/MD responses vary by Accept so caches key on it.
  ## Directory URLs served via MultiViews already get `Vary: negotiate,
  ## accept` from mod_negotiation automatically, so this FilesMatch only
  ## needs to cover the direct `.html`/`.md` requests.
  <FilesMatch "\.(html|md)$">
    Header append Vary "Accept"
  </FilesMatch>

  ## Serve .md files with the correct media type for agents.
  <FilesMatch "\.md$">
    Header set Content-Type "text/markdown; charset=utf-8"
  </FilesMatch>
</IfModule>

## Make sure Apache knows the .md extension maps to text/markdown
<IfModule mod_mime.c>
  AddType text/markdown .md
  AddCharset UTF-8 .md
</IfModule>

##### Enable gzip compression for resources
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE application/rss+xml application/atom+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff font/woff2 application/font-woff application/font-woff2
</IfModule>

<ifModule mod_gzip.c>
  mod_gzip_on Yes
  mod_gzip_dechunk Yes
  mod_gzip_item_include file \.(html?|txt|css|js|php)$
  mod_gzip_item_include handler ^cgi-script$
  mod_gzip_item_include mime ^text/.*
  mod_gzip_item_include mime ^application/x-javascript.*
  mod_gzip_item_exclude mime ^image/.*
  mod_gzip_item_exclude rspheader ^Content-Encoding:.*gzip.*
</ifModule>

##### Set Header Vary: Accept-Encoding
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|xml|gz|html|svg|json)$">
    Header append Vary: Accept-Encoding
  </FilesMatch>
</IfModule>
