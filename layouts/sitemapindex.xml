{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{/*
  Root /sitemap.xml — flat urlset listing canonical URLs from every
  language. We override Hugo's embedded sitemap index so the root file
  is directly consumable by validators and crawlers that do not follow
  <sitemapindex> references (see https://www.sitemaps.org/protocol.html).

  Per-language urlsets are still emitted at /<lang>/sitemap.xml via
  layouts/sitemap.xml. Pages noindexed in layouts/partials/essentials/head.html
  are excluded so only canonical, indexable URLs are advertised:
    - drop the root "/" redirect shim (noindex)
    - drop taxonomy list pages (/tags/, /categories/) — noindex + redirect
    - drop taxonomy term pages (/tags/foo/, /categories/bar/) — noindex
*/}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml"
        xmlns:video="http://www.google.com/schemas/sitemap-video/1.1">
  {{- range . -}}
    {{- range .Pages -}}
      {{- $isRoot := eq .RelPermalink "/" -}}
      {{- $isTaxonomy := or (eq .Kind "term") (eq .Kind "taxonomy") -}}
      {{- $isNoindex := .Params.noindex -}}
      {{- if and (not $isRoot) (not $isTaxonomy) (not $isNoindex) }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>
    {{- end }}
    {{- with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>
    {{- end }}
    {{- if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>
    {{- end }}
    {{- if .IsTranslated }}
    {{- range .AllTranslations }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.Lang }}" href="{{ .Permalink }}"/>
    {{- end }}
    {{- end }}
    {{- partial "seo/sitemap-video.html" . -}}
  </url>
      {{- end }}
    {{- end -}}
  {{- end }}
</urlset>
