{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{/*
  Custom sitemap — excludes pages that are noindexed in
  layouts/partials/essentials/head.html so the sitemap only
  advertises URLs Google should actually index:
    - drop the root "/" redirect shim (noindex)
    - drop taxonomy list pages (/tags/, /categories/) — noindex + redirect
    - drop taxonomy term pages (/tags/foo/, /categories/bar/) — noindex
*/}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml"
        xmlns:video="http://www.google.com/schemas/sitemap-video/1.1">
  {{ range .Data.Pages }}
    {{- $isRoot := eq .RelPermalink "/" -}}
    {{- $isTaxonomy := or (eq .Kind "term") (eq .Kind "taxonomy") -}}
    {{- $isNoindex := .Params.noindex -}}
    {{- if and (not $isRoot) (not $isTaxonomy) (not $isNoindex) }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{ if not .Lastmod.IsZero }}<lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>{{ end }}
    {{ with .Sitemap.ChangeFreq }}<changefreq>{{ . }}</changefreq>{{ end }}
    {{ if ge .Sitemap.Priority 0.0 }}<priority>{{ .Sitemap.Priority }}</priority>{{ end }}
    {{ if .IsTranslated }}
    {{ range .AllTranslations }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.Lang }}" href="{{ .Permalink }}"/>
    {{ end }}
    {{ end }}
    {{- /* Google video sitemap extension: advertise the demo clip on any
           page that carries an enabled video_demo front-matter block. */ -}}
    {{- with .Params.video_demo }}
    {{- if .enable }}
      {{- $vWebm := "" }}{{ $vMp4 := "" }}{{ $vPoster := "" }}
      {{- with .webm }}{{ with resources.Get . }}{{ $vWebm = .Permalink }}{{ end }}{{ end }}
      {{- with .mp4 }}{{ with resources.Get . }}{{ $vMp4 = .Permalink }}{{ end }}{{ end }}
      {{- with .poster }}{{ with resources.Get . }}{{ $vPoster = .Permalink }}{{ end }}{{ end }}
      {{- $vContent := or $vWebm $vMp4 }}
      {{- if and $vContent $vPoster }}
    <video:video>
      <video:thumbnail_loc>{{ $vPoster }}</video:thumbnail_loc>
      <video:title>{{ .title }}</video:title>
      <video:description>{{ .description | default $.Description }}</video:description>
      <video:content_loc>{{ $vContent }}</video:content_loc>
      {{- with .duration_seconds }}
      <video:duration>{{ . }}</video:duration>
      {{- end }}
      {{- with .uploadDate }}
      <video:publication_date>{{ . }}T00:00:00+00:00</video:publication_date>
      {{- end }}
    </video:video>
      {{- end }}
    {{- end }}
    {{- end }}
  </url>
    {{- end }}
  {{ end }}
</urlset>
